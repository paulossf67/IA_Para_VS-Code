{
  "name": "local-ai-vscode",
  "displayName": "Local AI Assistant",
  "description": "Assistente de IA 100% local para VS Code (Ollama). Chat, autocomplete e comandos de código.",
  "version": "0.4.2",
  "publisher": "paulosergio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulosergio/local-ai-vscode"
  },
  "bugs": {
    "url": "https://github.com/paulosergio/local-ai-vscode/issues"
  },
  "homepage": "https://github.com/paulosergio/local-ai-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "ollama",
    "local",
    "copilot",
    "chatgpt",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "local-ai.openChat",
        "title": "Local AI: Abrir Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "local-ai.createCode",
        "title": "Local AI: Criar Código"
      },
      {
        "command": "local-ai.validateWorkspace",
        "title": "Local AI: Validar Projeto"
      },
      {
        "command": "local-ai.reviewCurrentFile",
        "title": "Local AI: Revisar Arquivo Atual"
      },
      {
        "command": "local-ai.explainCode",
        "title": "Local AI: Explicar Código"
      },
      {
        "command": "local-ai.generateDocs",
        "title": "Local AI: Gerar Documentação"
      },
      {
        "command": "local-ai.refactorCode",
        "title": "Local AI: Refatorar Código"
      },
      {
        "command": "local-ai.generateTests",
        "title": "Local AI: Gerar Testes"
      },
      {
        "command": "local-ai.fixCode",
        "title": "Local AI: Corrigir Código"
      },
      {
        "command": "local-ai.completeHere",
        "title": "Local AI: Completar Aqui"
      },
      {
        "command": "local-ai.selectModel",
        "title": "Local AI: Escolher Modelo",
        "icon": "$(settings-gear)"
      },
      {
        "command": "local-ai.exportHistory",
        "title": "Local AI: Exportar Histórico",
        "icon": "$(export)"
      },
      {
        "command": "local-ai.clearHistory",
        "title": "Local AI: Limpar Histórico",
        "icon": "$(trash)"
      },
      {
        "command": "local-ai.selectContextFiles",
        "title": "Local AI: Selecionar Arquivos para Context"
      },
      {
        "command": "local-ai.clearContextFiles",
        "title": "Local AI: Limpar Seleção de Arquivos"
      },
      {
        "command": "local-ai.configureAI",
        "title": "Local AI: Configurar Provedor IA"
      },
      {
        "command": "local-ai.analyzeCommit",
        "title": "Local AI: Analisar Commit"
      },
      {
        "command": "local-ai.generateCommitMsg",
        "title": "Local AI: Gerar Mensagem de Commit"
      },
      {
        "command": "local-ai.validateBeforePush",
        "title": "Local AI: Validar Antes de Push"
      },
      {
        "command": "local-ai.organizeContext",
        "title": "Local AI: Organizar Grupos de Context"
      },
      {
        "command": "local-ai.previewContext",
        "title": "Local AI: Ver Contexto Enviado à IA"
      },
      {
        "command": "local-ai.saveSnippet",
        "title": "Local AI: Salvar Snippet"
      },
      {
        "command": "local-ai.insertSnippet",
        "title": "Local AI: Inserir Snippet"
      },
      {
        "command": "local-ai.migrateContextSelection",
        "title": "Local AI: Migrar Seleção Antiga de Context"
      },
      {
        "command": "local-ai.semanticSearch",
        "title": "Local AI: Busca Semântica",
        "icon": "$(search)"
      },
      {
        "command": "local-ai.indexProject",
        "title": "Local AI: Indexar Projeto para Busca",
        "icon": "$(database-add)"
      },
      {
        "command": "local-ai.codeGenetics",
        "title": "Local AI: Evolução do Código (Genetics)",
        "icon": "$(history)"
      },
      {
        "command": "local-ai.exportSettings",
        "title": "Local AI: Exportar Configurações",
        "icon": "$(export)"
      },
      {
        "command": "local-ai.importSettings",
        "title": "Local AI: Importar Configurações",
        "icon": "$(import)"
      },
      {
        "command": "local-ai.backupSettings",
        "title": "Local AI: Backup de Configurações",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "local-ai.restoreSettingsBackup",
        "title": "Local AI: Restaurar Backup de Configurações",
        "icon": "$(cloud-download)"
      },
      {
        "command": "local-ai.clearEmbeddingCache",
        "title": "Local AI: Limpar Cache de Embeddings",
        "icon": "$(trash)"
      },
      {
        "command": "local-ai.openModelManager",
        "title": "Local AI: Gerenciar Modelos",
        "icon": "$(package)"
      },
      {
        "command": "local-ai.showUsageStats",
        "title": "Local AI: Ver Estatísticas de Uso",
        "icon": "$(graph)"
      },
      {
        "command": "local-ai.clearUsageStats",
        "title": "Local AI: Limpar Estatísticas de Uso",
        "icon": "$(trash)"
      },
      {
        "command": "local-ai.exportUsageStats",
        "title": "Local AI: Exportar Estatísticas de Uso",
        "icon": "$(export)"
      },
      {
        "command": "local-ai.slashCommands",
        "title": "Local AI: Gerenciar Slash Commands",
        "icon": "$(symbol-key)"
      },
      {
        "command": "local-ai.showOfflineQueue",
        "title": "Local AI: Ver Fila Offline",
        "icon": "$(sync)"
      },
      {
        "command": "local-ai.retryOfflineQueue",
        "title": "Local AI: Retentar Fila Offline",
        "icon": "$(sync)"
      },
      {
        "command": "local-ai.clearOfflineQueue",
        "title": "Local AI: Limpar Fila Offline",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "local-ai.createCode",
          "group": "local-ai@0",
          "when": "editorTextFocus"
        },
        {
          "command": "local-ai.reviewCurrentFile",
          "group": "local-ai@0.5",
          "when": "editorTextFocus"
        },
        {
          "command": "local-ai.explainCode",
          "group": "local-ai@1",
          "when": "editorHasSelection"
        },
        {
          "command": "local-ai.generateDocs",
          "group": "local-ai@2",
          "when": "editorHasSelection"
        },
        {
          "command": "local-ai.refactorCode",
          "group": "local-ai@3",
          "when": "editorHasSelection"
        },
        {
          "command": "local-ai.generateTests",
          "group": "local-ai@4",
          "when": "editorHasSelection"
        },
        {
          "command": "local-ai.fixCode",
          "group": "local-ai@5",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "local-ai.openChat"
        },
        {
          "command": "local-ai.createCode"
        },
        {
          "command": "local-ai.validateWorkspace"
        },
        {
          "command": "local-ai.reviewCurrentFile"
        },
        {
          "command": "local-ai.explainCode"
        },
        {
          "command": "local-ai.generateDocs"
        },
        {
          "command": "local-ai.refactorCode"
        },
        {
          "command": "local-ai.generateTests"
        },
        {
          "command": "local-ai.fixCode"
        },
        {
          "command": "local-ai.completeHere"
        },
        {
          "command": "local-ai.selectModel"
        },
        {
          "command": "local-ai.exportHistory"
        },
        {
          "command": "local-ai.clearHistory"
        },
        {
          "command": "local-ai.selectContextFiles"
        },
        {
          "command": "local-ai.clearContextFiles"
        },
        {
          "command": "local-ai.migrateContextSelection"
        },
        {
          "command": "local-ai.semanticSearch"
        },
        {
          "command": "local-ai.indexProject"
        },
        {
          "command": "local-ai.codeGenetics"
        },
        {
          "command": "local-ai.exportSettings"
        },
        {
          "command": "local-ai.importSettings"
        },
        {
          "command": "local-ai.backupSettings"
        },
        {
          "command": "local-ai.restoreSettingsBackup"
        },
{
          "command": "local-ai.exportUsageStats"
        },
        {
          "command": "local-ai.openModelManager"
        },
        {
          "command": "local-ai.showUsageStats"
        },
        {
          "command": "local-ai.clearUsageStats"
        },
        {
          "command": "local-ai.exportUsageStats"
        },
        {
          "command": "local-ai.slashCommands"
        },
        {
          "command": "local-ai.showOfflineQueue"
        },
        {
          "command": "local-ai.retryOfflineQueue"
        },
        {
          "command": "local-ai.clearOfflineQueue"
        }
      ],
      "view/title": [
        {
          "command": "local-ai.selectModel",
          "when": "view == local-ai.chatView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "local-ai.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "local-ai.completeHere",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space"
      }
    ],
    "configuration": {
      "title": "Local AI",
      "properties": {
        "local-ai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "URL da API do Ollama"
        },
        "local-ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Modelo a ser usado (ex: qwen2.5-coder:7b, deepseek-coder-v2:16b)"
        },
        "local-ai.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Ativar autocomplete enquanto digita"
        },
        "local-ai.inlineCompletionDelay": {
          "type": "number",
          "default": 800,
          "description": "Delay em ms antes de mostrar sugestão de autocomplete",
          "minimum": 100
        },
        "local-ai.maxTokens": {
          "type": "number",
          "default": 1024,
          "description": "Máximo de tokens na resposta",
          "minimum": 16
        },
        "local-ai.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Temperatura (0 = mais determinístico, 1 = mais criativo)",
          "minimum": 0,
          "maximum": 2
        },
        "local-ai.numCtx": {
          "type": "number",
          "default": 8192,
          "minimum": 1024,
          "description": "Tamanho do contexto (em tokens) enviado ao Ollama. O padrão do Ollama é pequeno (2048–4096) e corta código longo. Valores maiores usam mais memória RAM/VRAM."
        },
        "local-ai.maxHistoryMessages": {
          "type": "number",
          "default": 20,
          "minimum": 2,
          "description": "Quantas mensagens anteriores do chat são enviadas ao modelo. As mais antigas são descartadas para não estourar o contexto."
        },
        "local-ai.maxHistorySize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Tamanho máximo do histórico persistido em MB."
        },
        "local-ai.enableAutoReview": {
          "type": "boolean",
          "default": true,
          "description": "Analisar código automaticamente ao salvar"
        },
        "local-ai.enableDashboard": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar dashboard com métricas do projeto"
        },
        "local-ai.enableSemanticSearch": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar busca semântica com embeddings (requer modelo nomic-embed-text no Ollama)"
        },
        "local-ai.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Modelo de embeddings no Ollama (ex: nomic-embed-text, all-minilm)"
        },
        "local-ai.similarityThreshold": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.1,
          "maximum": 0.9,
          "description": "Limiar de similaridade para busca semântica (0.1-0.9)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-ai",
          "title": "Local AI",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "local-ai": [
        {
          "type": "webview",
          "id": "local-ai.chatView",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "local-ai.dashboard",
          "name": "Dashboard",
          "when": "local-ai.dashboardEnabled"
        },
        {
          "type": "webview",
          "id": "local-ai.modelManager",
          "name": "Modelos",
          "icon": "$(package)"
        },
        {
          "type": "webview",
          "id": "local-ai.usageStats",
          "name": "Usage Stats",
          "icon": "$(graph)"
        },
        {
          "type": "webview",
          "id": "local-ai.slashCommands",
          "name": "Slash Commands",
          "icon": "$(symbol-key)"
        },
        {
          "type": "webview",
          "id": "local-ai.offlineQueue",
          "name": "Offline Queue",
          "icon": "$(sync)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copy-assets.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.140.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
